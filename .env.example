
# Do not commit real production passwords or API keys to git repository.

# Server Port Configuration
PORT=3000
NODE_ENV=production

# Supabase Auth Configuration (Vite Frontend & API)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Database Connection Settings (Supabase PostgreSQL / Standard PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-supabase-id.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_production_db_password_here

# Alternatively, standard PostgreSQL connection parameters:
# PGHOST=db.your-supabase-id.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=your_production_db_password_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_signing_secret_here

# Admin Account Initial Bootstrap (Only used if database has zero users)
ADMIN_INITIAL_FULL_NAME=System Administrator
ADMIN_INITIAL_EMAIL=admin@yourcompany.com
ADMIN_INITIAL_PASSWORD=YourStrongPassword2026!

# Application Base URL (used for password reset links)
APP_URL=https://your-resolveiq-domain.com

# Optional AI Features API Keys (Groq / Gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery Configuration for Password Reset & System Notifications
# Option 1: Resend
RESEND_API_KEY=re_your_resend_api_key
# Option 2: SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# Option 3: Standard SMTP (Gmail, AWS SES, Mailgun, Postmark, etc.)
# SMTP_HOST=smtp.mailprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM="ResolveIQ Operations <no-reply@yourcompany.com>"
EMAIL_FROM="ResolveIQ Operations <no-reply@yourcompany.com>"

# Contact Form Inbound Email Destination
CONTACT_RECEIVER_EMAIL=cubicfuture07@gmail.com

